{
  "name": "0xtero.hanninen.eu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "bundle install && bundle exec jekyll build",
  "forwardPorts": [
    4000
  ],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.pi/agent,target=/home/vscode/.pi/agent,type=bind,consistency=cached",
    {
      "source": "${localEnv:HOME}/.pi",
      "target": "/home/vscode/.pi",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/nvim",
      "target": "/home/vscode/.config/nvim",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu"
}
